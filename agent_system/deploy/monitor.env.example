# /etc/agent_system/monitor.env  (sudo chmod 600, 소유자 root)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MM_CONFIG_PATH=/opt/agent_system/data/configs.json
MM_DB_PATH=/opt/agent_system/data/market_alerts.db
MM_CHECK_INTERVAL=180
MM_COOLDOWN_MIN=15
MM_REPORT_HOUR=18
# 텔레그램 대화 봇: 명령을 받을 chat_id (쉼표 구분, tools/check_telegram.py 로 확인)
TELEGRAM_ALLOWED_CHAT_IDS=
BOT_RULES_PATH=/opt/agent_system/config/rules.example.json
# 로컬 AI
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 클라우드 AI (있는 것만 입력)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# 대시보드 비밀번호 (미설정 시 대시보드가 실행을 거부함)
DASHBOARD_PASSWORD=
