# /etc/agent_system/monitor.env  (sudo chmod 600, 소유자 root)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MM_CONFIG_PATH=/opt/agent_system/data/configs.json
MM_DB_PATH=/opt/agent_system/data/market_alerts.db
MM_CHECK_INTERVAL=180
MM_COOLDOWN_MIN=15
MM_REPORT_HOUR=18
# 대시보드 비밀번호 (미설정 시 대시보드가 실행을 거부함)
DASHBOARD_PASSWORD=
