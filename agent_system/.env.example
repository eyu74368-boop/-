# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  copy .env.example .env  →  notepad .env
# .env 는 GitHub 에 올라가지 않습니다. 이 예시 파일에는 실제 값을 적지 마세요.

# 텔레그램 (@BotFather 에서 발급한 전체 토큰, 따옴표 없이)
TELEGRAM_BOT_TOKEN=
# 명령을 받을 chat_id (tools\check_telegram.py 로 확인, 여러 개면 쉼표)
TELEGRAM_ALLOWED_CHAT_IDS=
# 시장 알림을 받을 chat_id
TELEGRAM_CHAT_ID=

# 로컬 AI
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 클라우드 AI (있는 것만)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
